APP_NAME=AI90
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://a90.local

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.127.126.26
DB_PORT=3306
DB_DATABASE=a90
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Disk lưu ảnh (ảnh mẫu, ảnh đầu vào, ảnh kết quả). Production: s3. Local dev: media
MEDIA_DISK=media
SIGNED_URL_TTL_MINUTES=15

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@a90.local
ADMIN_PASSWORD=

# Đăng nhập bằng Google: OAuth Client ID loại "Web application" trên Google Cloud Console (trùng VITE_GOOGLE_CLIENT_ID của frontend)
GOOGLE_CLIENT_ID=

# true: có công tắc "AI viết nội dung" khi tạo bài và nút "Viết lại bằng AI" (Claude API, cần ANTHROPIC_API_KEY)
SOCIAL_AI_CONTENT=false

# Tạo đơn GHN từ ảnh (note/tao-don-ghn-tu-anh.txt ở repo frontend). Staging GHN: https://dev-online-gateway.ghn.vn
GHN_BASE_URL=https://online-gateway.ghn.vn
# AI đọc ảnh chat -> đơn nháp, AI viết nội dung bài đăng: gọi thẳng Claude API (mặc định claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Đăng TikTok qua API (người dùng tự kết nối, gửi vào hộp thư). Xem note/dang-tiktok-qua-api.txt ở repo frontend.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Trang frontend TikTok trả về sau khi người dùng đồng ý (kèm code, state), khớp chính xác Redirect URI trên Developer Portal
TIKTOK_REDIRECT_URI=https://a51.vn/mxh/tiktok/author
# Ảnh gửi TikTok: bucket đọc công khai qua tên miền đã xác minh với TikTok
TIKTOK_MEDIA_DISK=s3_tiktok
TIKTOK_MEDIA_BUCKET=
TIKTOK_MEDIA_URL=https://media.a51.vn
